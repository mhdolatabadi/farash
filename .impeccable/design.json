  "narrative": {
    "northStar": "شیشهٔ شب — night glass",
    "overview": "A quiet indigo room at night, lit by a warm lamp that moves with the project and a cool light across the room. The list lives in the room; frosted glass appears only where content passes beneath it: the app bar once scrolled under, the floating capture bar, the navigation pane and the editor side sheet. The structure is plain Material 3 so a Todoist or TickTick user trusts it at once; the brand lives in the light, the Naskh project title and the done stamp.",
    "keyCharacteristics": [
      "Two lights behind the glass: a moving honey lamp and a fixed cool room light.",
      "Glass only over passing content; one pane per region, never glass on glass.",
      "Medium top app bar naming the project in Naskh.",
      "Full-bleed rows on phones; 760px measure on wide screens.",
      "Honey means now; sage tomorrow; pomegranate overdue."
    ],
    "rules": [
      {
        "name": "The One Lamp Rule",
        "body": "Honey is spent only on now: today, the done stamp, the focused capture edge and the one primary action.",
        "section": "Colors"
      },
      {
        "name": "The Single Pane Rule",
        "body": "One pane of glass per region; a pane never contains another pane, a field box or a card.",
        "section": "Elevation & Depth"
      },
      {
        "name": "The Persian Reading Rule",
        "body": "RTL and directional spacing everywhere; account email isolated LTR.",
        "section": "Typography"
      },
      {
        "name": "The Reachable Control Rule",
        "body": "Every action target is at least 48px.",
        "section": "Layout"
      }
    ],
    "dos": [
      "Take every color from FarashPalette.nightGlass, priorities included.",
      "Use glass only where content passes beneath it, with light behind it.",
      "Name the current project in the app bar on every width.",
      "Edit in a side sheet on wide screens and a modal bottom sheet on phones.",
      "Honor reduced motion."
    ],
    "donts": [
      "Nest glass in glass or box a field inside a pane.",
      "Frame the whole phone screen in a pane.",
      "Float the editor as a short card inside the list.",
      "Add texture patterns to the glass.",
      "Add eyebrow labels or tiny floating labels over the editor title.",
      "Spend honey on secondary actions, icons or selection."
    ]
  }
}