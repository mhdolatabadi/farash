  "narrative": {
    "northStar": "The Quiet Desk",
    "overview": "A luminous, quiet desk for capturing and arranging real tasks. Pale mist and ivory light surround milky panes; deep teal ink gives semantic task content clear hierarchy. This captures the user's light, calm glass direction and the implemented Flutter system, rather than the generated comparison image.\n\nPersian RTL and bundled Vazirmatn are durable identity commitments. Android and Web share the same visual vocabulary; the coordinated dark theme changes illumination and ink while keeping structure and controls consistent.",
    "keyCharacteristics": [
      "Milky large panes over code-native ambient illumination.",
      "Readable task rows with restrained hierarchy.",
      "Persian-first typography and directional layout.",
      "Reversible actions and visible, semantic task controls."
    ],
    "rules": [
      {
        "name": "The Content First Rule.",
        "body": "Keep task text on the near-opaque surface and use illumination behind it, never as a replacement for semantic content.",
        "section": "Colors"
      },
      {
        "name": "The Persian Reading Rule.",
        "body": "Keep Persian content RTL, use directional spacing, and explicitly isolate account email as LTR.",
        "section": "Typography"
      },
      {
        "name": "The Reachable Control Rule.",
        "body": "Maintain (48px) action targets for icon buttons, primary buttons and task completion; visual check circles may remain smaller inside those targets.",
        "section": "Layout"
      },
      {
        "name": "The Bounded Glass Rule.",
        "body": "Blur the workspace and navigation surfaces, never each task row.",
        "section": "Elevation & Depth"
      }
    ],
    "dos": [
      "Do preserve Persian RTL and bundled Vazirmatn.",
      "Do keep task text, navigation and actions semantic.",
      "Do use large, near-opaque glass panes and readable task measures.",
      "Do preserve keyboard-aware capture and editor spacing.",
      "Do honor reduced motion for authored selection animations."
    ],
    "donts": [
      "Don't blur each task row.",
      "Don't ship the generated comparison board as UI artwork.",
      "Don't introduce decorative controls for unimplemented features.",
      "Don't claim hardware performance or accessibility-service validation from source inspection."
    ]
  }
