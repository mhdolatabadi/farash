FROM debian:bookworm-slim AS build

ARG FLUTTER_VERSION=3.47.8
ARG FLUTTER_SHA256=baf7dcc5a3dbba60fe863bf493a6cf203195621f7786eaa5a1bba02cd0d87dd2

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl git xz-utils && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
      "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
      -o /tmp/flutter.tar.xz && \
    echo "${FLUTTER_SHA256}  /tmp/flutter.tar.xz" | sha256sum -c - && \
    tar -xJf /tmp/flutter.tar.xz -C /opt && \
    rm /tmp/flutter.tar.xz && \
    git config --global --add safe.directory /opt/flutter

ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"

WORKDIR /app
COPY pubspec.yaml pubspec.lock analysis_options.yaml ./
COPY lib ./lib
COPY web ./web
COPY assets ./assets

# Empty by default: the web app then calls the API on its own origin.
# --no-web-resources-cdn serves CanvasKit from this image instead of gstatic.com,
# which is slow or blocked for many users.
ARG API_BASE_URL=
RUN flutter --version && \
    flutter pub get && \
    flutter build web --release --no-web-resources-cdn --dart-define=API_BASE_URL=${API_BASE_URL}

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
