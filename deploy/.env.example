FARASH_DOMAIN=todo.example.com
# Use a URL-safe value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Signs API access tokens. Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-a-long-random-token-secret
# Token lifetime in hours.
AUTH_TOKEN_TTL_HOURS=24
# Prebuilt images (published once the deployment issue lands)
FARASH_IMAGE_REPO=ghcr.io/mhdolatabadi/farash
