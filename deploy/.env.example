FARASH_DOMAIN=todo.example.com
# Use a URL-safe value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Signs API access tokens. Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-a-long-random-token-secret
# Token lifetime in hours.
AUTH_TOKEN_TTL_HOURS=24
# Prebuilt images (published once the deployment issue lands)
FARASH_IMAGE_REPO=ghcr.io/mhdolatabadi/farash
# Existing external Docker network used by the server's shared nginx proxy.
FARASH_PROXY_NETWORK=proxynet

# Optional read-only Google Calendar broker. Disabled until OAuth and signed
# Android/browser return flows have been verified with your Google OAuth client.
CALENDAR_GOOGLE_ENABLED=false
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
CALENDAR_GOOGLE_CALLBACK_URL=
CALENDAR_WEB_RETURN_URL=
CALENDAR_ANDROID_RETURN_URL=
# Active key ID and JSON key ring: {"key-id":"base64-encoded-32-byte-key"}.
# Generate key material outside source control: openssl rand -base64 32
CALENDAR_TOKEN_KEY_ID=
CALENDAR_TOKEN_KEYS=
